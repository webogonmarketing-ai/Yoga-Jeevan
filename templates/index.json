ections\/yoga-meditation-blankets","title":"Handwoven Fabrics in Harmony With Nature","text":"","button_label":"Shop Now"}}},"block_order":["16589904396fdc24dd-0","16589904396fdc24dd-1"],"settings":{"wide_display":false,"promo_text_on_image_enabled":true,"featured_promos_per_row":2,"featured_links_animation":"fadeInDown","feature_style":"square","css_class":"","custom_css":""}},"video_xQ3FCT":{"type":"video","settings":{"wide_display":true,"aspect_ratio":"4:3","autoplay":true,"autoloop":true,"mute_video":false,"show_controls":true,"video_dark_overlay":false,"iframe_video":"https:\/\/vimeo.com\/988735918?share=copy","html5_video":"","display_text_over_video":false,"preheading":"","heading":"","subheading":"","button1_label":"Play Video","button1_link":"","button1_style":"global-button--banner","button2_label":"","button2_link":"","button2_style":"global-button--banner","text_position":"center","text_align":"center","caption_content_background":"original","mobile_image_crop":"none","mobile_text_below_image":true,"mobile_text_color":"","css_class":"","custom_css":""}},"image-with-text-overlay-2":{"type":"image-with-text-overlay","settings":{"wide_display":true,"image":"shopify:\/\/shop_images\/IMG_9828.webp","pretext":"","title":"","subtitle":"","button1":"Start Your Wellness Journey With Us Now","button1_link":"shopify:\/\/products\/anti-skid-indigo-yoga-mat-non-slip-mat-for-yoga","button1_style":"global-button--banner-highlighted","button2":"","button2_link":"","button2_style":"global-button--banner","text_position":"left","text_align":"left","caption_content_background":"original","mobile_image_crop":"none","mobile_text_below_image":true,"mobile_text_color":"#000000","css_class":"Subheading","custom_css":".Subheading\n{\n font-size: 80px;\n}"}},"16585674348fd88644":{"type":"apps","settings":{}},"ed23b886-a49e-430d-a12f-800c29d19ec7":{"type":"testimonial","blocks":{"template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-1":{"type":"image","settings":{"title":"","testimonial":"<p>I could not be more satisfied with the Organic Cotton Mat! It is perfect for my Ashtanga Yoga practice, exactly what I was looking for. Simple, soft organic cotton, easy to clean and it fits perfectly atop my yoga mat! It came exactly as described on the description. I would recommend washing it before using to eliminate excess fuzzies that may shed off. Aside from that, I am over the moon with my purchase!<\/p>","name":"","store_name":"Pilare Tena, CA (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-2":{"type":"image","settings":{"title":"","testimonial":"<p>I was amazed at the quality of this mat at first sight! It's heavy and thick, and longer than average mats. Feels like a thick carpet adapted for yoga. As long as you don't mind slight imperfections that are to be expected from a handmade product, this is a top quality mat! It doesn't slip on my hardwood floor and my hands have enough grip. The only downside I would think about is the heavy weight and the fact you need to hand wash it from time to time. Apart from that I am 100% satisfied and would buy again in a heartbeat. <\/p>","name":"","store_name":"Leeloo, Sherbrooke (Canada)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-3":{"type":"image","settings":{"title":"","testimonial":"<p>Very prompt shipping.  The meditation chair is of Excellent build quality. Really good design. Good use of materials. Instructions are easy to follow. The wood itself has good vibes. My friends like using it for yoga stretches. I like using it for working outdoors in the sun. I also like using it at retreats and events, but it is very large and heavy, it can be tricky to carry around. It is VERY firm, a little more firm than I would like, but it is still very usable. Thank you so much for the great product!<\/p>","name":"","store_name":"Joseph Thornton, CA (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"2db59a94-c58f-463c-ba59-23d6b9f39be5":{"type":"image","settings":{"title":"","testimonial":"<p>Wow this is by far the nicest yoga mat I've ever had! Not only is it absolutely stunning with the block-printed design, but it's also durable and functional. I LOVE the carrying case it came in and the personal touch in the packaging. I much prefer the cork to foam as it's more natural and grounding. It is slightly less slip-proof than rubber\/foam, but that is to be expected and it still allows me to go into my full asana practice. I get compliments on it all the time, and I truly feel it makes my practice that much more personal and beautiful. I highly recommend!<\/p>","name":"","store_name":"Elizabeth Goodman, USA","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"4e83234b-b6de-4687-879c-5fe565cc8620":{"type":"image","settings":{"title":"","testimonial":"<p>I am beyond thrilled with my orders! I truly appreciate the handmade and quality materials + affordability. I also love the colors! I hope to keep this for years and years to come. Thank you<\/p>","name":"","store_name":"Elle, NJ (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"9c5215af-c2a5-4396-bb92-d5c848068eff":{"type":"image","settings":{"title":"","testimonial":"<p>absolutely love this meditation cushion. fast delivery to new zealand. beautiful fabric. zip so cover can be washed. perfect. thank you<\/p>","name":"","store_name":"Cara Williams, Auckland (New Zealand)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"3ab29ca6-70b2-4386-9381-991d630cc9b7":{"type":"image","settings":{"title":"","testimonial":"<p>this is my first yoga rug after years of using a mat and i couldn’t be happier with it!! the anti-slip backing is a great investment if you’re considering which you’d like. delivery was super quick considering it traveled overseas and the seller was very communicative and kind. the rug has a couple minor “imperfections” as it is handcrafted, which makes me love it even more!! thanks so much y’all!<\/p>","name":"","store_name":"Taylor Tumbiolo, NC (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"b7f18b12-53ab-4e9f-b3d5-53fc52ae7ef0":{"type":"image","settings":{"title":"","testimonial":"<p>This yoga mat is the level of human-touched quality that only comes from truly handmade textiles. I can feel the care that went into the weaving and dying. It's very thick and sturdy, grips better than a rubber mat and feels so nice. The optional rubber backing is nice for my smooth floors. This is a birthday gift for my husband and we are both very pleased.<\/p>","name":"","store_name":"Monet Fort, GA (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"87f9ca92-1770-4800-b39e-f31651fc1e37":{"type":"image","settings":{"title":"","testimonial":"<p>Gorgeous. Absolutely stunning handwoven blankets. I can't imagine what it took to warp the loom. They're perfect, thick and soft, they even smell great. They're exactly what I've always wanted, even more beautiful than expected. I will treasure them. Thank you so so much. If I could give more than 5 stars I would.<\/p>","name":"","store_name":"Robin Stephanie, Germany","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"edab3e10-e980-495a-b338-f72272196637":{"type":"image","settings":{"title":"","testimonial":"<p>I have been practicing Asana for 20 years and have been waiting to find a mat and company like this! Honest, pure & well made. The grip is perfect, I ordered the felt back. I do not slip, I feel the perfect amount of cushion on a hardwood floor that doesn’t affect my balancing but still pads my joints. Above all, the energy of practicing on natural fiber vs rubber\/plastic isn’t even comparable! I have practiced Bikram yoga 3xs so far on it, afterwards I hang it to dry in the sun. Doesn’t collect smell. Will try washing when necessary. I highly suggest this mat for any - especially a serious practitioner.<\/p>","name":"","store_name":"Lisa Apatni, NY (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"256342b1-71e0-444a-add7-e44ca702a5a9":{"type":"image","settings":{"title":"","testimonial":"<p>I am completely satisfied with my yoga mat. It was made with such care and love. It is true authentic and has many healing properties. This mat is absolutely gorgeous and has beautiful green colors of the Indian Kush grass. The smell is like sitting in a field of it. Thank you for offering such a quality product.<\/p>","name":"","store_name":"Tosha Warren, VA (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"f4ec73ae-f337-447b-97b6-84dac5bd305e":{"type":"image","settings":{"title":"","testimonial":"<p>This is my favorite yoga mat. It looks amazing and it doesn’t smell like most foam Matt’s do. I love the quality and craftsmanship. I ordered one for my husband also and will get more for my family members. I highly recommend this shop.<\/p>","name":"","store_name":"Lizzie Peach, MT (USA)","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"92edd6cc-4eed-4595-911c-409bee06ca4d":{"type":"image","settings":{"title":"","testimonial":"<p>I have purchased multiple items from this shop and am always impressed with the customer service and quality of their products. This cushion is beautiful and exceeded my expectations.<\/p>","name":"","store_name":"Jez, Picton, New Zealand","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}},"a1709a62-9356-4bf2-ad8c-22cdc0b8e1b2":{"type":"image","settings":{"title":"","testimonial":"<p>The mat arrived as estimated. No problems with Fedex which I'm very glad the shipper used. I am 177 cm and the size is wonderful. The natural cotton is great. It looks clean, and arrived in a well packaged box and bag. I did a small yoga sequence to test while on the hardwood and the tension created kept the mat in place even without the latex backing. I opted for this mat because it was organic, and contained no harsh dyes. Lululemon doesn't have anything on this. I'm very excited to use this in my practice.<\/p>","name":"","store_name":"Kiran, USA","link":"","text_position":"center","text_align":"center","mobile_image_crop":"none","caption_content_background":"original"}}},"block_order":["template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-1","template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-2","template--16306612109548__ed23b886-a49e-430d-a12f-800c29d19ec7-image-3","2db59a94-c58f-463c-ba59-23d6b9f39be5","4e83234b-b6de-4687-879c-5fe565cc8620","9c5215af-c2a5-4396-bb92-d5c848068eff","3ab29ca6-70b2-4386-9381-991d630cc9b7","b7f18b12-53ab-4e9f-b3d5-53fc52ae7ef0","87f9ca92-1770-4800-b39e-f31651fc1e37","edab3e10-e980-495a-b338-f72272196637","256342b1-71e0-444a-add7-e44ca702a5a9","f4ec73ae-f337-447b-97b6-84dac5bd305e","92edd6cc-4eed-4595-911c-409bee06ca4d","a1709a62-9356-4bf2-ad8c-22cdc0b8e1b2"],"settings":{"wide_display":true,"testimonial_text_animation":"fadeIn","testimonial_speed":6,"activate_adaptiveHeight":false,"mobile_text_below_image":true,"mobile_text_co
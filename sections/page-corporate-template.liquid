{% style %}
  .main-heading {
    margin-block: 130px;
    text-align: center;
    font-weight: 700;
    font-size: 40px;
    line-height: 1.2;
    color: #72866D;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    text-decoration: none;
    text-shadow: none;
  }
  .main-heading-description {
    font-size: 16px;
    line-height: 1.5;
    color: #000;
    text-align: center;
    text-decoration: none;
    text-shadow: none;
    font-weight: 600;
  }


  {% comment %}
    media query will goes here...
  {% endcomment %}

  @media (max-width: 768px) {
    .main-heading {
      font-size: 25px;
      margin-block: 60px;
      font-weight: bold;
    }
    .main-heading-description {
      font-size: 14px;
    }
  }

{% endstyle %}


<div class="main-heading">
  {{ section.settings.title }}
  <p class="main-heading-description">{{ section.settings.description }}</p>
</div>


<div></div>


{% schema %}
  {
    "name": "Page Corporate Template",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Corporate Program"
      }, {
        "type": "text",
        "id": "description",
        "label": "Description",
        "default": "Corporate Wellness Program “Yoga Jeevan” – An Experiential program led by YogaKargha Studio"
      }
    ]
  }
{% endschema %}
{% style %}
  .main-heading {
    display: block;
    margin-block: {{ section.settings.margin_block }}px;
    text-align: center;
    font-weight: 700;
    font-size: 40px;
    line-height: 1.2;
    color: #72866D;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-shadow: none;
    width: {{ section.settings.image_width }};
    margin: {{ section.settings.margin_block }}px auto;
  }
  .main-heading-description {
    font-size: 16px;
    line-height: 1.5;
    color: #000;
    text-align: center;
    text-decoration: none;
    text-shadow: none;
    font-weight: 600;
  }


  {% comment %}
    media query will goes here...
  {% endcomment %}

  @media (max-width: 768px) {
    .main-heading {
      font-size: 25px;
      margin-block: {{ section.settings.margin_block_mobile }}px;
      font-weight: bold;
    }
    .main-heading-description {
      font-size: 14px;
    }
  }

{% endstyle %}


<div class="main-heading">
  {{ section.settings.title }}
  <p class="main-heading-description">{{ section.settings.description }}</p>
</div>




{% schema %}
  {
    "name": "Page Corporate Template",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Corporate Program"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description",
        "default": "Corporate Wellness Program “Yoga Jeevan” – An Experiential program led by YogaKargha Studio"
      },
      {
        "type": "range",
        "id": "margin_block",
        "label": "Margin block",
        "default": 130,
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_block_mobile",
        "label": "Margin block mobile",
        "default": 60,
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px"
      }, {
        "type": "text",
        "id": "image_width",
        "label": "Image width",
        "default": "100%",
        "info": "Enter the width of the image in pixels. Example: 1000px"
      }, 
      {
        "type": "range",
        "id": "heading-para",
        "label": "heading and paragraph",
        "default" : 0,
        "min": 0,
        "max": 60,
        "step": 4,
        "unit": "px"
      }
    ]
  }
{% endschema %}
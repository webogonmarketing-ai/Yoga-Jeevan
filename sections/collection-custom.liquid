{%- comment -%}
Product card snippet: expects a 'product' object in scope.
Usage inside a collection loop:
{% for product in collection.products %}
  {% render 'product-card', product: product %}
{% endfor %}
{%- endcomment -%}

<div class="pc-card" data-product-id="{{ product.id }}">
  {%- assign first_variant = product.variants.first -%}

  {%- comment -%}
  detect if any variant has compare_at_price > price and pick the first such variant
  {%- endcomment -%}
  {%- assign sale_variant = nil -%}
  {%- for v in product.variants -%}
    {%- if v.compare_at_price and v.compare_at_price > v.price -%}
      {%- assign sale_variant = v -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if sale_variant -%}
    {%- comment -%}
    compute discount percent in steps to avoid Liquid parser errors
    {%- endcomment -%}
    {%- assign diff = sale_variant.compare_at_price | minus: sale_variant.price -%}
    {%- assign numerator = diff | times: 100 -%}
    {%- assign discount_percent = numerator | divided_by: sale_variant.compare_at_price | round -%}
    <div class="pc-badge">-{{ discount_percent }}%</div>
  {%- endif -%}

  <!-- image -->
  <a class="pc-image-link" href="{{ product.url }}">
    <div class="pc-image-wrap">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}">
      {% else %}
        <!-- fallback to uploaded demo image (local path) -->
        <img src="/mnt/data/d93643bd-1be0-4024-863d-7d7dbcb08c9a.png" alt="{{ product.title | escape }}">
      {% endif %}
    </div>
  </a>

  <!-- rating (replace with real metafield if available) -->
  <div class="pc-rating" aria-hidden="true">
    <span>★★★★★</span>
  </div>

  <!-- title -->
  <a class="pc-title" href="{{ product.url }}">
    {{ product.title | truncate: 40 }}
  </a>

  <!-- price block -->
  <div class="pc-prices">
    {%- assign displayed_variant = product.selected_or_first_available_variant -%}
    {%- if displayed_variant.compare_at_price and displayed_variant.compare_at_price > displayed_variant.price -%}
      <span class="pc-compare">₹{{ displayed_variant.compare_at_price | money_without_trailing_zeros }}</span>
    {%- endif -%}
    <span class="pc-price">₹{{ displayed_variant.price | money_without_trailing_zeros }}</span>
  </div>

  <!-- action: Select options -> product page if multiple variants, or ADD TO CART if single variant -->
  <div class="pc-action">
    {%- assign selectable = false -%}
    {%- if product.variants.size > 1 or product.options.size > 1 -%}
      {%- assign selectable = true -%}
    {%- endif -%}

    {%- if selectable -%}
      <a class="pc-btn pc-select" href="{{ product.url }}">Select options</a>
    {%- else -%}
      <form class="pc-add-to-cart-form" data-product-id="{{ product.id }}">
        <input type="hidden" name="id" value="{{ first_variant.id }}">
        <button type="submit" class="pc-btn pc-add">ADD TO CART</button>
      </form>
    {%- endif -%}
  </div>
</div>

<!-- Modal markup (one modal per page - it will be reused) -->
<div id="pc-added-modal" class="pc-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="pc-modal-backdrop" data-close="true"></div>
  <div class="pc-modal-panel" role="document">
    <button class="pc-modal-close" data-close="true" aria-label="Close">✕</button>
    <div class="pc-modal-body">
      <img id="pc-modal-image" src="/mnt/data/d93643bd-1be0-4024-863d-7d7dbcb08c9a.png" alt="Product" />
      <div class="pc-modal-info">
        <h3 id="pc-modal-title">Added to cart</h3>
        <p id="pc-modal-sub">1 item added to your cart.</p>
        <div class="pc-modal-actions">
          <a href="/cart" class="pc-btn pc-view-cart">View cart</a>
          <button class="pc-btn pc-continue" data-close="true">Continue shopping</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Product card styles */
.pc-card {
  width: 100%;
  max-width: 260px;
  background: #fff;
  padding: 12px;
  box-sizing: border-box;
  border-radius: 8px;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}
.pc-badge {
  position: absolute;
  left: 10px;
  top: 10px;
  background: #6b46c1;
  color: #fff;
  padding: 6px 8px;
  font-size: 12px;
  border-radius: 12px;
  z-index: 2;
  font-weight: 600;
}
.pc-image-wrap{
  background: #f7efe9;
  border-radius: 8px;
  padding: 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow: 0 8px 20px rgba(0,0,0,0.04);
  margin-bottom: 12px;
  min-height: 170px;
}
.pc-image-wrap img{
  max-width: 100%;
  max-height: 160px;
  object-fit: contain;
  display:block;
}
.pc-rating { font-size: 13px; color: #ffb703; margin-bottom: 8px; }
.pc-title { display:block; color:#111; font-size: 14px; font-weight:600; margin-bottom: 6px; text-decoration: none; }
.pc-prices { display:flex; align-items:center; gap:8px; margin-bottom: 12px; }
.pc-compare { text-decoration: line-through; color:#8b8b8b; font-size:13px; }
.pc-price { font-weight:700; color:#111; font-size:16px; }
.pc-action { margin-top:6px; }
.pc-btn { width:100%; padding:10px 12px; border-radius:8px; font-weight:700; cursor:pointer; display:inline-block; text-align:center; text-decoration:none; transition: transform .08s ease; border: 2px solid transparent; }
.pc-btn:active { transform: scale(.995); }
.pc-btn.pc-select { background: #fff; color: #111; border: 2px solid #111; }
.pc-btn.pc-add { background: #111; color: #fff; border: 2px solid #111; }

/* Modal styles */
.pc-modal { display:none; position:fixed; inset:0; z-index:9999; align-items:center; justify-content:center; }
.pc-modal[aria-hidden="false"] { display:flex; }
.pc-modal-backdrop { position: absolute; inset:0; background: rgba(0,0,0,0.4); }
.pc-modal-panel { position: relative; background:#fff; border-radius:12px; padding:18px; max-width:720px; width:90%; margin:auto; z-index:2; box-shadow: 0 20px 40px rgba(0,0,0,0.15); display:flex; align-items:center; }
.pc-modal-close { position:absolute; right:12px; top:8px; background:transparent; border:none; font-size:18px; cursor:pointer; }
.pc-modal-body { display:flex; gap:16px; align-items:center; width:100%; }
#pc-modal-image { width:120px; height:120px; object-fit:contain; border-radius:8px; background:#fafafa; padding:8px; }
.pc-modal-info h3 { margin:0 0 6px 0; font-size:18px; }
.pc-modal-info p { margin:0 0 12px 0; color:#666; }
.pc-modal-actions { display:flex; gap:10px; }
.pc-view-cart { background:#111; color:#fff; padding:10px 14px; border-radius:8px; text-decoration:none; font-weight:700; }
.pc-continue { background:#fff; color:#111; padding:10px 14px; border-radius:8px; border:2px solid #111; cursor:pointer; font-weight:700; }
</style>

<script>
/* Ajax add-to-cart + modal logic (no nested <script>) */
document.addEventListener('DOMContentLoaded', function(){
  // delegate submit for add-to-cart forms
  document.body.addEventListener('submit', function(e){
    const form = e.target;
    if (!form.classList.contains('pc-add-to-cart-form')) return;
    e.preventDefault();

    const btn = form.querySelector('button');
    const formData = new FormData(form);
    const variantId = formData.get('id');

    if (!variantId) {
      alert('Variant not found.');
      return;
    }

    btn.disabled = true;
    const originalText = btn.innerText;
    btn.innerText = 'Adding...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new URLSearchParams({ id: variantId, quantity: 1 })
    })
    .then(resp => {
      if (!resp.ok) throw resp;
      return resp.json();
    })
    .then(data => {
      // show modal with product info
      showAddedModal(data);
      btn.innerText = 'Added';
      setTimeout(() => {
        btn.disabled = false;
        btn.innerText = originalText;
      }, 900);
      window.dispatchEvent(new CustomEvent('pc:cart:added', { detail: data }));
    })
    .catch(async (err) => {
      let msg = 'Could not add to cart.';
      try {
        const j = await err.json();
        if (j && j.description) msg = j.description;
      } catch(e){}
      alert(msg);
      btn.disabled = false;
      btn.innerText = originalText;
    });
  });

  // modal open/close helpers
  const modal = document.getElementById('pc-added-modal');
  modal.addEventListener('click', function(e){
    if (e.target.dataset && e.target.dataset.close) closeModal();
  });

  function showAddedModal(item) {
    // item contains the added item details from Shopify API
    // try to set title and image; fallback to product fallback image path
    const titleEl = document.getElementById('pc-modal-title');
    const subEl = document.getElementById('pc-modal-sub');
    const imgEl = document.getElementById('pc-modal-image');

    titleEl.textContent = item.title || 'Added to cart';
    subEl.textContent = (item.quantity ? item.quantity : 1) + ' item added to your cart.';
    if (item.image) {
      imgEl.src = item.image;
    } else if (item.featured_image) {
      imgEl.src = item.featured_image;
    } else {
      imgEl.src = '/mnt/data/d93643bd-1be0-4024-863d-7d7dbcb08c9a.png';
    }

    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // keyboard close (escape)
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') {
      const m = document.getElementById('pc-added-modal');
      if (m && m.getAttribute('aria-hidden') === 'false') closeModal();
    }
  });
});
</script>

<section class="shop-by-category">
  <div class="container">
    {% if section.settings.heading_text != blank %}
      <h2 class="heading {{ section.settings.heading_alignment }}">
        {{ section.settings.heading_text }}
      </h2>
    {% endif %}
    
    <div class="categories-swiper">
      <div class="swiper-container">
        <div class="swiper-wrapper">
          {% for block in section.blocks limit: section.settings.items_limit %}
            <div class="category-item swiper-slide">
              <a href="{{ block.settings.link }}" class="category-link">
                <div class="category-image">
                  <img 
                    src="{{ block.settings.image | img_url: '500x500' }}" 
                    alt="{{ block.settings.alt_text }}"
                    loading="lazy"
                  >
                </div>
                <h3 class="category-title">{{ block.settings.title }}</h3>
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </div>
</section>

<style>
.shop-by-category {
  text-align: center;
  padding: 50px 20px;
  max-width: 1180px;
  margin: auto;
  overflow: hidden;
  position: relative;
}

.shop-by-category .heading {
  font-size: 24px;
  margin-bottom: 30px;
}

/* Heading alignment */
.shop-by-category .heading.left { text-align: left; }
.shop-by-category .heading.center { text-align: center; }
.shop-by-category .heading.right { text-align: right; }

.category-item {
  text-align: center;
}

.category-image img {
  border-radius: 50%;
  width: 500px;
  height: 500px;
  object-fit: cover;
  margin: auto;
  transition: transform 0.3s ease;
}

.category-link:hover .category-image img {
  transform: scale(1.05);
}

.category-title {
  margin-top: 10px;
  font-size: 14px;
  font-weight: 400;
  color: black;
  text-transform: uppercase;
}

/* Swiper */
.categories-swiper .swiper-container {
  overflow: hidden;
  width: 100%;
}

.swiper-pagination {
  margin-top: 20px;
}

.swiper-pagination-bullet {
  background-color: #ddd;
  width: 10px;
  height: 10px;
  opacity: 1;
}

.swiper-pagination-bullet-active {
  background-color: #8d7045;
}

/* Responsive adjustments */
@media screen and (max-width: 768px) {
  .shop-by-category {
    padding: 30px 15px;
  }

  .shop-by-category .heading {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .category-image img {
    width: 300px;
    height: 300px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const swiper = new Swiper('.swiper-container', {
    slidesPerView: {{ section.settings.slides_per_view }},
    spaceBetween: 20,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    breakpoints: {
      320: {
        slidesPerView: 2,
        spaceBetween: 10,
      },
      480: {
        slidesPerView: 3,
        spaceBetween: 15,
      },
      768: {
        slidesPerView: 4,
        spaceBetween: 20,
      },
      1024: {
        slidesPerView: {{ section.settings.slides_per_view }},
        spaceBetween: 30,
      },
    },
  });
});
</script>

{% schema %}
{
  "name": "Shop by Category (Swiper)",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Number of Slides Visible (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_limit",
      "label": "Total Items to Display",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category (Swiper)",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
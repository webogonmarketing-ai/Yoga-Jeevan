<section class="shop-by-category">
  <div class="container">
    {% if section.settings.heading_text != blank %}
      <h2 class="heading {{ section.settings.heading_alignment }}">
        {{ section.settings.heading_text }}
      </h2>
    {% endif %}
  </div>

  <div class="categories-swiper">
    <div class="swiper-container">
      <div class="swiper-wrapper">
        {% for block in section.blocks limit: section.settings.items_limit %}
          <div class="category-item swiper-slide">
            <a href="{{ block.settings.link }}" class="category-link">
              <div class="category-image">
                <img 
                  src="{{ block.settings.image | img_url: 'master' }}" 
                  alt="{{ block.settings.alt_text }}"
                  loading="lazy"
                  style="--img-width: {{ section.settings.image_width }}px; --img-height: {{ section.settings.image_height }}px;"
                >
              </div>
              <h3 class="category-title">{{ block.settings.title }}</h3>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<style>
.shop-by-category {
  padding: 50px 20px;
  overflow: hidden;
  position: relative;
}

.shop-by-category .heading {
  font-size: 24px;
  margin-bottom: 30px;
  text-align: {{ section.settings.heading_alignment }};
  width: 100%;
}

.categories-swiper {
  width: 100%;
}

.categories-swiper .swiper-container {
  width: 100%;
  margin-left: 0;
  padding-left: 0;
}

.swiper-wrapper {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

.category-item {
  text-align: center;
  box-sizing: border-box;
}

.category-image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.category-image img {
  width: var(--img-width);
  height: var(--img-height);
  max-width: 100%;
  max-height: 100%;
  object-fit: cover;
  border-radius: 6px;
  transition: transform 0.3s ease;
}

/* Responsive Scaling — auto shrink without overlap */
@media (max-width: 1200px) {
  .category-image img {
    width: calc(var(--img-width) * 0.8);
    height: calc(var(--img-height) * 0.8);
  }
}

@media (max-width: 992px) {
  .category-image img {
    width: calc(var(--img-width) * 0.7);
    height: calc(var(--img-height) * 0.7);
  }
}

@media (max-width: 768px) {
  .shop-by-category {
    padding: 30px 10px;
  }

  .shop-by-category .heading {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .category-image img {
    width: calc(var(--img-width) * 0.6);
    height: calc(var(--img-height) * 0.6);
  }
}

@media (max-width: 480px) {
  .category-image img {
    width: calc(var(--img-width) * 0.5);
    height: calc(var(--img-height) * 0.5);
  }
}

.category-link:hover .category-image img {
  transform: scale(1.05);
}

.category-title {
  margin-top: 10px;
  font-size: 14px;
  font-weight: 400;
  color: black;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Swiper Pagination */
.swiper-pagination {
  margin-top: 20px;
}

.swiper-pagination-bullet {
  background-color: #ddd;
  width: 10px;
  height: 10px;
  opacity: 1;
}

.swiper-pagination-bullet-active {
  background-color: #8d7045;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const swiper = new Swiper('.swiper-container', {
    slidesPerView: {{ section.settings.slides_per_view }},
    spaceBetween: 20,
    loop: true, // loop back to start automatically
    autoplay: {
      delay: {{ section.settings.autoplay_delay | times: 1000 }}, // convert seconds to ms
      disableOnInteraction: false, // keeps autoplay active after user swipes
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    breakpoints: {
      320: {
        slidesPerView: 2.2,
        spaceBetween: 10,
      },
      480: {
        slidesPerView: 3,
        spaceBetween: 15,
      },
      768: {
        slidesPerView: 4,
        spaceBetween: 20,
      },
      1024: {
        slidesPerView: {{ section.settings.slides_per_view }},
        spaceBetween: 25,
      },
    },
  });
});
</script>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Number of Slides Visible (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_limit",
      "label": "Total Items to Display",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Base Image Width (px)",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 300
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Base Image Height (px)",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 300
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (seconds)",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
